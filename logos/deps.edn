{:paths ["src" "notebooks"]
 :deps  {org.scicloj/clay {:mvn/version "2.0.24"}}
 :aliases
 {;; export the SVGs and render the notebook to HTML: `clojure -M:build`
  :build {:main-opts ["-m" "notknowing-garden.main"]}
  ;; a REPL to work in: `clojure -M:nrepl` (writes .nrepl-port)
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}}
          :main-opts  ["-m" "nrepl.cmdline"]}}}
